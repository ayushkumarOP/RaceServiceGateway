{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://raceservice-frontend-dev-dot-racingglazing.de.r.appspot.com",
      "https://raceservice-frontend-dot-racingglazing.de.r.appspot.com"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "user-auth-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "user-users-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "user-discovery-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "forum-categories-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "forum-forums-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/forums/{**catch-all}"
        }
      },
      "forum-threads-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/threads/{**catch-all}"
        }
      },
      "forum-comments-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/comments/{**catch-all}"
        }
      },
      "forum-tags-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/tags/{**catch-all}"
        }
      },
      "forum-reports-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        }
      },
      "forum-moderation-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/moderation/{**catch-all}"
        }
      },
      "forum-race-threads-route": {
        "ClusterId": "forumservice-cluster",
        "Match": {
          "Path": "/api/v1/races/{raceId:guid}/threads/{**catch-all}"
        }
      },
      "race-api-route": {
        "ClusterId": "raceservice-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "health-route": {
        "ClusterId": "raceservice-cluster",
        "Match": {
          "Path": "/health"
        }
      },
      "scalar-route": {
        "ClusterId": "raceservice-cluster",
        "Match": {
          "Path": "/scalar/{**catch-all}"
        }
      },
      "openapi-route": {
        "ClusterId": "raceservice-cluster",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "raceservice-cluster": {
        "Destinations": {
          "raceservice-api": {
            "Address": "http://raceservice-api:8080"
          }
        }
      },
      "forumservice-cluster": {
        "Destinations": {
          "forumservice-api": {
            "Address": "http://forumservice-api:8080"
          }
        }
      },
      "userservice-cluster": {
        "Destinations": {
          "userservice-api": {
            "Address": "http://userservice-api:8080"
          }
        }
      }
    }
  }
}
